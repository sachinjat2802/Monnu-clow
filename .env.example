# ============================================================================
# Monnu Clow — Environment Configuration
# Copy this to .env and add your API keys
# ============================================================================

# Choose your AI provider (auto-detects from available API keys if not set)
# Options: nvidia, openai, anthropic, google, ollama
# MONNU_LLM_PROVIDER=nvidia

# ─── NVIDIA NIM (RECOMMENDED — multiple specialized models) ─────────────────
# Get your key at: https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-... (leave empty to use default trial key)
NVIDIA_API_KEY=
#
# NVIDIA models used per feature:
#   🧠 Planner:     nvidia/nemotron-3-super-120b-a12b
#   ⚡ Coder:        qwen/qwen3.5-122b-a10b
#   🔧 Debugger:     deepseek-ai/deepseek-v3_2
#   🧪 Tester:       qwen/qwen3.5-122b-a10b
#   👁️ Reviewer:     qwen/qwen3.5-397b-a17b
#   🛡️ Security:     nvidia/nemotron-3-super-120b-a12b
#   🔍 Embeddings:   nvidia/llama-nemotron-embed-1b-v2
#   📊 Reranking:    nvidia/llama-nemotron-rerank-1b-v2

# ─── Google AI (Gemini) ──────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza... (leave empty to use default trial key)
GOOGLE_API_KEY=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Model override (optional) ───────────────────────────────────────────────
# MONNU_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# MONNU_LLM_TEMPERATURE=0.2
# MONNU_LLM_MAX_TOKENS=4096
# MONNU_LLM_BASE_URL=

# ─── Server configuration ────────────────────────────────────────────────────
# PORT=3001
# HOST=0.0.0.0
# TARGET_REPO=.
